---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

// MDX maps post images here (<Content components={{ img: PostImage }} />)
interface Props {
  src: string | ImageMetadata
  alt?: string
  [key: string]: any
}

const { src, alt = '', ...rest } = Astro.props
---

{
  typeof src === 'string' ? (
    <img src={src} alt={alt} {...rest} loading="lazy" decoding="async" />
  ) : (
    <Image
      src={src}
      alt={alt}
      {...rest}
      widths={[480, 736, 1080, 1472]}
      sizes="(min-width: 768px) 736px, calc(100vw - 2rem)"
    />
  )
}
