---
import logo from '@/assets/logo.png'
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { buttonVariants } from '@/components/ui/button'
import { NAV_LINKS, SITE } from '@/consts'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

// Slash-agnostic active check, mirrored by initHeader below for client-side navigations
const norm = (p: string) => p.replace(/\/+$/, '') || '/'
const current = norm(Astro.url.pathname)
const isActive = (href: string) => {
  const h = norm(href)
  return h !== '/' && (current === h || current.startsWith(h + '/'))
}
---

<header transition:persist class="border-b border-transparent transition-colors duration-300" id="site-header">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-3">
      <Image
        src={logo}
        alt="Logo"
        width={24}
        height={24}
        densities={[1, 2, 3]}
        format="webp"
        loading="eager"
        class="size-5 sm:size-6"
      />
      <span class="hidden text-lg font-medium min-[300px]:block whitespace-nowrap">
        {SITE.title}</span
      >
    </Link>
    <div class="flex items-center sm:gap-4">
      <nav aria-label="Main" class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class={cn(
                'hover:text-foreground/80 capitalize transition-colors',
                isActive(item.href)
                  ? 'text-foreground font-medium'
                  : 'text-foreground/60',
              )}
              aria-current={isActive(item.href) ? 'page' : undefined}
              data-nav-link
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <button
        type="button"
        popovertarget="mobile-nav"
        title="Menu"
        class={cn(
          buttonVariants({ variant: 'ghost', size: 'icon' }),
          'size-8 sm:hidden',
        )}
      >
        <Icon name="lucide:menu" class="size-5" />
        <span class="sr-only">Toggle menu</span>
      </button>
      {/* Opens where the old dropdown did: 4px below the trigger, right edges aligned */}
      <nav
        id="mobile-nav"
        popover
        aria-label="Main"
        class="bg-background text-foreground fixed inset-auto top-12 right-10 z-50 m-0 min-w-[8rem] rounded-md border p-1 shadow-md"
      >
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground block rounded-sm px-2 py-1.5 text-sm font-medium capitalize"
              aria-current={isActive(item.href) ? 'page' : undefined}
              data-nav-link="menu"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Without the Popover API the [popover] attribute is ignored, so hide the menu until toggled */
  @supports not selector(:popover-open) {
    #mobile-nav {
      display: none;
    }
    #mobile-nav.open {
      display: block;
    }
  }
</style>

<script>
  let currentScrollHandler: (() => void) | null = null;

  const norm = (p: string) => p.replace(/\/+$/, '') || '/';
  const supportsPopover = 'popover' in HTMLElement.prototype;

  function initHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    // Clean up previous scroll listener to prevent accumulation
    if (currentScrollHandler) {
      window.removeEventListener('scroll', currentScrollHandler);
    }

    // Scroll-aware border
    const updateBorder = () => {
      if (window.scrollY > 10) {
        header.classList.remove('border-transparent');
        header.classList.add('border-border');
      } else {
        header.classList.add('border-transparent');
        header.classList.remove('border-border');
      }
    };

    currentScrollHandler = updateBorder;
    window.addEventListener('scroll', updateBorder, { passive: true });
    updateBorder();

    // Active nav link: server-rendered on first load, refreshed here because the header persists across navigations
    const currentPath = norm(window.location.pathname);
    header.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((link) => {
      const href = norm(link.getAttribute('href') ?? '');
      const isActive = href !== '/' && (currentPath === href || currentPath.startsWith(href + '/'));
      if (isActive) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
      // Mobile menu links keep a single style
      if (link.dataset.navLink === 'menu') return;
      link.classList.toggle('text-foreground', isActive);
      link.classList.toggle('font-medium', isActive);
      link.classList.toggle('text-foreground/60', !isActive);
    });
  }

  // Fallback toggle for browsers without the Popover API
  if (!supportsPopover) {
    document.addEventListener('click', (e) => {
      if (!(e.target as Element | null)?.closest?.('[popovertarget="mobile-nav"]')) return;
      document.getElementById('mobile-nav')?.classList.toggle('open');
    });
  }

  // Close the mobile menu as soon as a navigation starts (link click, back/forward)
  document.addEventListener('astro:before-preparation', () => {
    const nav = document.getElementById('mobile-nav');
    if (!nav) return;
    if (supportsPopover) {
      if (nav.matches(':popover-open')) nav.hidePopover();
    } else nav.classList.remove('open');
  });

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
