---
import { Button } from '@/components/ui/button'
import { Icon } from 'astro-icon/components'
---

<Button
  id="theme-toggle"
  variant="ghost"
  size="icon"
  title="Toggle theme"
  className="-me-2 size-8"
>
  <Icon
    name="lucide:sun"
    class="size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
  />
  <Icon
    name="lucide:moon"
    class="absolute size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
  />
  <span class="sr-only">Toggle theme</span>
</Button>

<script>
  // The theme itself is applied, and carried across navigations, by the inline
  // bootstrap script in Head.astro; this only wires up the toggle button.
  function syncToggleLabel() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark'
    document
      .getElementById('theme-toggle')
      ?.setAttribute(
        'aria-label',
        isDark ? 'Switch to light theme' : 'Switch to dark theme',
      )
  }

  function handleToggleClick() {
    const element = document.documentElement
    const currentTheme = element.getAttribute('data-theme')
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

    element.classList.add('[&_*]:transition-none')
    element.setAttribute('data-theme', newTheme)
    element.classList.remove('scheme-dark', 'scheme-light')
    element.classList.add(newTheme === 'dark' ? 'scheme-dark' : 'scheme-light')

    window.getComputedStyle(element).getPropertyValue('opacity')

    requestAnimationFrame(() => {
      element.classList.remove('[&_*]:transition-none')
    })

    syncToggleLabel()

    // Only an explicit choice is persisted; storage may be blocked
    try {
      localStorage.setItem('theme', newTheme)
    } catch {}
  }

  function initThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle')
    if (themeToggle) {
      // Remove previous listener before adding new one to prevent accumulation
      themeToggle.removeEventListener('click', handleToggleClick)
      themeToggle.addEventListener('click', handleToggleClick)
    }
    syncToggleLabel()
  }

  initThemeToggle()

  document.addEventListener('astro:after-swap', initThemeToggle)
</script>
